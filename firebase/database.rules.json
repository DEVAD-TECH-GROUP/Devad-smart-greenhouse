{
  "rules": {
    ".read": false,
    ".write": false,
    "devices": {
      "$deviceId": {
        "uplink": {
          ".read": "auth != null && auth.token.device === true",
          ".write": "auth != null && auth.token.device === true"
        },
        "downlink": {
          ".read": "auth != null && auth.token.device === true",
          ".write": false
        }
      }
    }
  }
}
