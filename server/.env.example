# ---- Server ----
PORT=4000
NODE_ENV=development
# Where the React app is served from in dev (CORS + cookies)
CLIENT_ORIGIN=http://localhost:5173

# ---- MongoDB (local or Atlas connection string) ----
MONGODB_URI=mongodb+srv://devadtechgroup_db_user:abcde12345.com@devad-tech-group.6lbtd11.mongodb.net/smart-greenhouse?retryWrites=true&w=majority

# ---- Auth (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ----
JWT_ACCESS_SECRET=replace-with-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

# ---- Firebase Admin ----
# Option A: path to the service-account JSON downloaded from Firebase console
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# Option B (for hosting platforms): the whole JSON on one line
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
FIREBASE_DATABASE_URL=https://YOUR-PROJECT-default-rtdb.firebaseio.com

# ---- Used by `npm run setup:device` (must match firmware/Secrets.h) ----
FIREBASE_DEVICE_EMAIL=greenhouse-device@example.com
FIREBASE_DEVICE_PASSWORD=change-me-please

# ---- History retention ----
TELEMETRY_RETENTION_DAYS=30
